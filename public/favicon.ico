<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <defs>
    <!-- Background subtle gradient depth -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050505" />
      <stop offset="100%" stop-color="#000000" />
    </linearGradient>

    <!-- Vibrant Cobalt Glow Gradient -->
    <linearGradient id="cobaltGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6" />
      <stop offset="100%" stop-color="#0047AB" />
    </linearGradient>

    <!-- Outer Ambient Glow Filter -->
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="1.2" flood-color="#0047AB" flood-opacity="0.8" />
    </filter>
  </defs>

  <!-- Pitch Black Base with Soft Cobalt Border -->
  <rect width="32" height="32" rx="8" fill="url(#bgGrad)" stroke="#0047AB" stroke-width="1.2" stroke-opacity="0.5" />

  <!-- Integrated Coding Terminal & AI Group with Glow -->
  <g filter="url(#glow)">
    <!-- Sleek, Precision Prompt (>): Straight paths, rounded corner and ends -->
    <path d="M7.5 9.5 L15 15.5 L7.5 21.5" fill="none" stroke="url(#cobaltGrad)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />

    <!-- Terminal AI Blinking Cursor Block -->
    <rect x="17" y="18.5" width="7.5" height="3" rx="1.5" fill="#3B82F6" />

    <!-- Live Execution Status Indicator with Outer Ring -->
    <circle cx="23.5" cy="8.5" r="3.2" fill="none" stroke="#0047AB" stroke-width="1" opacity="0.6" />
    <circle cx="23.5" cy="8.5" r="1.8" fill="#60A5FA" />
  </g>
</svg>
